# Ollama and Chroma hosts — only needed if the defaults don't work for your
# setup (e.g. WSL2, where Ollama on the Windows host isn't reachable at
# 127.0.0.1). See README.md's "Configuration" section.
OLLAMA_HOST=127.0.0.1:11434
CHROMA_HOST=localhost
CHROMA_PORT=8000

# GitHub tokens used by Claude Code when working in this repo (see
# CLAUDE.md's "Code Review Workflow"). Not read by the app itself.
#
# AI_BOT_GITHUB_TOKEN: token for the flowlaps-ai-reviewer account. Used
# exclusively to post independent code review comments to PRs, so feedback
# appears as flowlaps-ai-reviewer rather than as you. Needs repo scope on
# that account.
AI_BOT_GITHUB_TOKEN=

# GH_TOKEN: your own token, used for authoring actions (opening PRs,
# pushing, commenting as yourself). Kept separate from AI_BOT_GITHUB_TOKEN
# to preserve the reviewer/author role separation.
GH_TOKEN=
